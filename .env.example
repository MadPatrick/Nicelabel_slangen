# Kopieer dit bestand naar ".env" en vul de echte waarden in.
# ".env" staat in .gitignore en mag NOOIT in git terechtkomen.

DB_HOST=GEEVE-SQL-2019
DB_PORT=
DB_NAME=Slangkaarten
DB_USER=
DB_PASSWORD=

# DATA_SOURCE=direct (standaard) verbindt deze installatie rechtstreeks
# met SQL Server (heeft PDO_SQLSRV nodig, zie README.md). Zet op "bridge"
# als deze webserver geen driver mag installeren, en vul BRIDGE_URL en
# BRIDGE_API_KEY in - zie README.md, sectie "Geen driver-toegang op deze
# webserver? Gebruik een bridge". BRIDGE_URL wijst dan naar de
# bridge/index.php van een andere installatie van deze app (die wel
# DATA_SOURCE=direct + de DB_*-waarden heeft), BRIDGE_API_KEY moet op
# beide installaties exact hetzelfde geheime sleutel zijn.
DATA_SOURCE=direct
BRIDGE_URL=
BRIDGE_API_KEY=
